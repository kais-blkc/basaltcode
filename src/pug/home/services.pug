include ../parts/mixins/tabs-vertical.pug

mixin slmi(img, title)
  div(data-aos="fade-in-up")
    .sec-services__item
      img(src=img, alt="", loading="lazy")
      .sec-services__item-title=title

-
  var titles = [
    'Разработка сайтов и сервисов',
    'Разработка мобильных приложений',
    'UX/UI дизайн',
    'Разработка ботов',
    'Техническая поддержка',
    'Консультации'
  ]

  var images = [
    'img/service-site.jpg',
    'img/service-mobile.jpg',
    'img/service-design.jpg',
    'img/service-bot.jpg',
    'img/service-crm.jpg',
    'img/service-web-app.jpg'
  ]

  var services = {
    'Разработка сайтов и сервисов': [
      'Лендинги',
      'Интернет-магазины', 
      'Веб-приложения',
      'CRM-системы',
      'LMS-системы'
    ],
    'Разработка мобильных приложений': [
      'iOS',
      'Android'
    ],
    'UX/UI дизайн': [
      'Интерфейсы сайтов',
      'Мобильные приложения',
      'Брендинг',
      'Логотипы'
    ],
    'Разработка ботов': [
      'Telegram',
      'WhatsApp'
    ],
    'Техническая поддержка': [
      'Обслуживание сайтов',
      'Обновления',
      'Мониторинг',
      'Резервное копирование'
    ],
    'Консультации': [
      'Техническое планирование',
      'Выбор технологий',
      'Архитектура проектов',
      'Оптимизация'
    ]
  }

section#services.sec-services.sec-padding-y
  .container
    h2.h2(data-aos="fade-up") Наши услуги

    .d-none--mob
      +tabs-v(titles)
        each img, index in images
          +tabs-v-content(index+1, index == 0)
            .sec-services__img.block-absolute.img-cover
              img(src=img, alt="" loading="lazy")
            .sec-services__subcategories
              each subcategory in services[titles[index]]
                .sec-services__subcategory= subcategory

    .sec-services__list-mob
      +slmi('img/service-site.jpg', 'Разработка сайтов и сервисов')
      +slmi('img/service-mobile.jpg', 'Разработка мобильных приложений')
      +slmi('img/service-design.jpg', 'UX/UI дизайн')
      +slmi('img/service-bot.jpg', 'Разработка ботов')
      +slmi('img/service-crm.jpg', 'Техническая поддержка')
      +slmi('img/service-web-app.jpg', 'Консультации')
