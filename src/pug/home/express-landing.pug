section#express-landing.sec-express-landing.sec-padding-y
  .container
    .sec-express-landing__wrapper(data-aos="fade-up")
      .sec-express-landing__content
        .sec-express-landing__badge Акция до конца 2025 года
        h2.h2.sec-express-landing__title Экспресс лендинг
        .sec-express-landing__desc.text-c__secondary
          p Сделаем вам сайт за <span class="text-c__accent" style="font-weight: 700; font-size: 1.2em;">10к</span> в течение 2х дней
        button.btn.btn--accent.sec-express-landing__button(data-modal-open="express-landing") Заказать
      .sec-express-landing__image
        img(src="img/banner.jpg", alt="Экспресс лендинг", loading="lazy")

