mixin tabs-v-mobile(img, title)
  .sec-services__item(data-aos="fade-in-up")
    img(src=img, alt="")
    .sec-services__item-title=title


mixin tabs-v-content(index, active)
  - var isActive = active ? 'active' : ''
  .tabs-v__content-item(data-tabs-content=index class=isActive)
    block 

mixin tabs-v(titles, rtl=false)
  - var rtl = rtl ? 'rtl' : ''
  .tabs-v
    .tabs-v__list(data-tabs class=rtl)
      .tabs-v__list-left(data-aos="fade-right", data-aos-delay="400")
        .tabs-v__content
          block 

      //- .tabs-v__tabs.animate__animated.animate__fadeInRight
      .tabs-v__tabs(data-aos="fade-left" data-aos-delay="400")
        each title, index in titles
          - var isActive = index == 0 ? 'active' : ''
          button.tabs-v__tabs-item(data-tabs-title=index+1 class=isActive)!=title

mixin cases-slider-content(index, active, title, link, img)
  - var isActive = active ? 'active' : ''
  .cases-slider__content-item(data-tabs-content=index class=isActive)
    .cases-slider__content-wrapper
      .cases-slider__image-section
        .cases-slider__image
          img(src=img, alt=title, loading="lazy")
        h3.cases-slider__title=title
        a.cases-slider__link(href=link target="_blank") Посмотреть проект →
      .cases-slider__description
        .cases-slider__text
          block

mixin cases-slider(titles)
  .cases-slider(data-tabs)
    .cases-slider__tabs(data-aos="fade-up" data-aos-delay="200")
      each title, index in titles
        - var isActive = index == 0 ? 'active' : ''
        button.cases-slider__tab(data-tabs-title=index+1 class=isActive)!=title
    .cases-slider__content(data-aos="fade-up" data-aos-delay="400")
      block

